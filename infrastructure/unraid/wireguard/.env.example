# Copy to .env and adjust for the Unraid host.

# WireGuard UDP listener and public peer endpoint port. This is the port that
# should be forwarded from the internet/router and written into client configs.
WIREGUARD_BIND_IP=0.0.0.0
WIREGUARD_PORT=51028

# Public DNS name or public IP that remote clients use to reach WireGuard.
# Forward UDP/WIREGUARD_PORT on the router to the Unraid host.
WG_HOST=vpn.mbhome.biz

# Cloudflare DDNS updates the public A record used by WG_HOST.
# The Cloudflare token is read from ./secrets/cloudflare_api_token.txt.
# Keep this DNS-only, not Cloudflare proxied, because WireGuard is UDP.
DDNS_DOMAINS=vpn.mbhome.biz
DDNS_PROXIED=false
DDNS_IP6_PROVIDER=none
DDNS_UID=1000
DDNS_GID=1000

# VPN client tunnel settings generated into new peer configs.
# WG_DEFAULT_ADDRESS uses wg-easy's "x" placeholder for peer assignment.
WG_DEFAULT_ADDRESS=10.29.0.x
WG_DEFAULT_DNS=10.20.30.11,10.20.30.12,10.20.30.1
WG_ALLOWED_IPS=10.20.30.0/24

# wg-easy admin UI. Keep this LAN-only; do not forward this port publicly.
WG_EASY_UI_BIND_IP=10.20.30.50
WG_EASY_UI_PORT=51128

# wg-easy v15 allows HTTP access to the UI only when INSECURE is true.
# Set to false if you later place the UI behind HTTPS.
WG_EASY_INSECURE=true

# wg-easy v15 first-run setup. Leave disabled if you prefer using the UI setup.
# When enabled on a fresh ./wireguard volume, INIT_PORT is sourced from
# WIREGUARD_PORT in docker-compose.yml.
WG_EASY_INIT_ENABLED=false

# Docker interface used by wg-easy forwarding rules.
WG_DEVICE=eth0
